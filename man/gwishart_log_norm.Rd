\details{
\deqn{p(K \mid G, b, D) = I_G(b, D)^{-1} |K|^{(b - 2)/2}
  \exp\left\{-\frac{1}{2}\operatorname{tr}(KD)\right\},}{%
  p(K | G, b, D) = I_G(b, D)^-1 |K|^((b-2)/2) exp(-tr(K D)/2),}

